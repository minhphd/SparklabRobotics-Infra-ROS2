<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vlm_tamp_sparklab</name>
  <version>0.1.0</version>
  <description>Task-level tools a VLM drives the bimanual YAM-Ultra with: a tracked scene graph, pick, place, hand over.</description>
  <maintainer email="phdminh01@gmail.com">SparkLab</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>capx_sparklab</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- not rosdep: cap-x, cuRobo, GraspGenX, Open3D; run under scripts/capx_python.sh -->
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
